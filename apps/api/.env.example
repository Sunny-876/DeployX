# DeployX API Environment Configuration

# Database Connection
# Development (Local PostgreSQL):
DATABASE_URL="postgresql://deployx:deployx_password@localhost:5432/deployx?schema=public"
# Production (e.g. Neon, Supabase, AWS RDS, Railway):
# DATABASE_URL="postgresql://deployx_user:SECURE_PASSWORD@ep-sample-12345.us-east-2.aws.neon.tech/deployx?sslmode=require&schema=public&connection_limit=25"

# Server Port (PaaS hosting like Render, Railway, Fly.io injects process.env.PORT)
PORT=4000
API_PORT=4000

# Authentication Secret (Must be >= 32 characters in production)
JWT_SECRET=deployx-jwt-secret-student-platform-2026-replace-in-production-min-32-chars

# CORS (Allowed origins, comma-separated - NEVER use * in production)
# Development:
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production:
# CORS_ALLOWED_ORIGINS=https://deployx.vercel.app,https://yourdomain.com

# Local Agent Connection (for development)
AGENT_URL=http://localhost:4100

# ZIP Upload Limits & Security Guards
MAX_UPLOAD_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=300
MAX_ZIP_FILES=10000
MAX_ZIP_DEPTH=15

# Agent Pairing & Heartbeat Settings
AGENT_PAIRING_TTL_MS=600000
AGENT_HEARTBEAT_INTERVAL_MS=15000
AGENT_OFFLINE_AFTER_MS=45000

# Rate Limiting (In-memory sliding window, max requests per minute)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAIR_MAX=15
RATE_LIMIT_DEPLOY_MAX=40
