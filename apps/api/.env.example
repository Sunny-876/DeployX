# Required API environment variables
# Set real values only in local ignored .env files or the production provider.
DATABASE_URL=
JWT_SECRET=

# Render injects PORT. Use 4000 for local development.
PORT=4000
API_PORT=4000
NODE_ENV=development

# Comma-separated. Production must contain the real dashboard origin(s).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional admin allowlist (comma-separated email addresses)
ADMIN_EMAILS=

# Legacy direct Agent URL; development only when API and Agent share a machine.
# Production Agents connect outbound through authenticated pairing/heartbeats.
# AGENT_URL=http://localhost:4100

# ZIP upload limits and extraction guards
MAX_UPLOAD_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=300
MAX_ZIP_FILES=10000
MAX_ZIP_DEPTH=15

# Agent pairing and heartbeat
AGENT_PAIRING_TTL_MS=600000
AGENT_HEARTBEAT_INTERVAL_MS=15000
AGENT_OFFLINE_AFTER_MS=45000

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAIR_MAX=15
RATE_LIMIT_DEPLOY_MAX=40
