# DeployX Agent Environment Configuration
# Prefer a config.json file for installed Windows deployments.
# Environment variables still override the JSON config when provided.

# Local Agent Daemon Port (Runs locally on student machine)
AGENT_PORT=4100

# DeployX API Endpoint (Target API server the agent connects to)
# Development (Local API):
DEPLOYX_API_URL=http://localhost:4000
API_URL=http://localhost:4000
# Production (Cloud API HTTPS URL):
# DEPLOYX_API_URL=https://api.yourdomain.com
# API_URL=https://api.yourdomain.com

# Optional: override the default config path for packaged Windows installs
# DEPLOYX_CONFIG_PATH=C:\Users\YourName\AppData\Roaming\DeployX\config.json

# Docker Runtime Resource Limits for Student Projects
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2
CONTAINER_PIDS_LIMIT=512

# Execution Timeouts
BUILD_TIMEOUT_MS=900000
STARTUP_TIMEOUT_MS=600000

# Dynamic Host Port Allocation Range for Project Containers
PORT_MIN=3001
PORT_MAX=3999

# Agent Heartbeat Interval (ms)
AGENT_HEARTBEAT_INTERVAL_MS=15000
