# ==============================================================================
# DeployX Environment Configuration Template
# Copy this file to .env in each app (or configure in your production environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (API)
# ------------------------------------------------------------------------------
# Local Development:
DATABASE_URL=
# Production Example (with connection pooling and SSL):
# DATABASE_URL="postgresql://deployx_prod_user:SECURE_PASSWORD@db-host.internal:5432/deployx_prod?sslmode=require&schema=public&connection_limit=20"

# ------------------------------------------------------------------------------
# 2. API Server Configuration (apps/api)
# ------------------------------------------------------------------------------
PORT=4000
API_PORT=4000
JWT_SECRET=
ADMIN_EMAILS=
# Legacy direct Agent URL; local development only when API and Agent share a machine.
# Production Agents connect outbound through authenticated pairing.
# AGENT_URL=http://localhost:4100

# CORS Allowed Origins (Comma-separated, never use * in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ZIP Upload & Unpack Hardening
MAX_UPLOAD_SIZE_MB=100
MAX_EXTRACTED_SIZE_MB=300
MAX_ZIP_FILES=10000
MAX_ZIP_DEPTH=15

# Agent Pairing & Heartbeat
AGENT_PAIRING_TTL_MS=600000
AGENT_HEARTBEAT_INTERVAL_MS=15000
AGENT_OFFLINE_AFTER_MS=45000

# API Rate Limiting (In-Memory sliding window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_DEFAULT_MAX=120
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PAIR_MAX=15
RATE_LIMIT_DEPLOY_MAX=40

# ------------------------------------------------------------------------------
# 3. Agent Runtime Configuration (apps/agent)
# ------------------------------------------------------------------------------
AGENT_PORT=4100

# Build and Startup Timeouts
BUILD_TIMEOUT_MS=900000
STARTUP_TIMEOUT_MS=600000

# Container Resource Limits
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=2
CONTAINER_PIDS_LIMIT=512

# Host Port Allocation Range for Project Containers
PORT_MIN=3001
PORT_MAX=3999

# ------------------------------------------------------------------------------
# 4. Dashboard Web Application (apps/dashboard)
# ------------------------------------------------------------------------------
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:4000
